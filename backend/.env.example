# Salin file ini menjadi backend/.env lalu sesuaikan dengan MySQL lokal (XAMPP/phpMyAdmin).
PORT=4000
DATABASE_URL="mysql://root:@localhost:3306/otk_db"
FRONTEND_URL=http://localhost:5173
APP_BASE_URL=http://localhost:4000
ADMIN_EMAIL=admin@otk.local
ADMIN_PASSWORD=GANTI_DENGAN_PASSWORD_KUAT
ADMIN_API_KEY=GANTI_DENGAN_SECRET_ACAK_PANJANG
# Metode pembayaran hanya pilihan yang disimpan pada pesanan; tidak ada gateway otomatis.
